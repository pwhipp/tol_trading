{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tol.schema.json",
  "title": "Trading Orchestration Language (TOL) v1",
  "type": "object",
  "required": ["version", "mode", "actions"],
  "additionalProperties": false,

  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "TOL language version"
    },

    "mode": {
      "type": "string",
      "enum": ["paper", "live"]
    },

    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },

  "$defs": {
    "ticker": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z0-9]+\\.[A-Z0-9_]+$",
      "description": "Ticker symbol with exchange suffix (validated at runtime)"
    },

    "percent": {
      "type": "string",
      "pattern": "^(100|[1-9][0-9]?|0\\.[0-9]+)%$",
      "description": "Percentage > 0% and ≤ 100%"
    },

    "money": {
      "type": "string",
      "pattern": "^[$€£¥][0-9]+(,[0-9]{3})*(\\.[0-9]{1,2})? \\([A-Z]{3}\\)$",
      "description": "Currency-denominated monetary value"
    },

    "cashSource": {
      "type": "string",
      "pattern": "^CASH \\([A-Z]{3}\\)$",
      "description": "Cash balance in a specific currency"
    },

    "sellActionRef": {
      "type": "string",
      "pattern": "^sell[A-Z0-9]+\\.[A-Z0-9_]+(_[0-9]+)?$",
      "description": "Derived identifier of a sell action"
    },

    "quantity": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "$ref": "#/$defs/percent" },
        { "$ref": "#/$defs/money" },
        {
          "type": "string",
          "enum": ["ALL"]
        }
      ]
    },

    "using": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/cashSource" },
          { "$ref": "#/$defs/ticker" },
          { "$ref": "#/$defs/sellActionRef" }
        ]
      },
      "uniqueItems": true
    },

    "sellAction": {
      "type": "object",
      "required": ["symbol", "quantity", "using"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/$defs/ticker" },
        "quantity": { "$ref": "#/$defs/quantity" }
      }
    },

    "buyAction": {
      "type": "object",
      "required": ["symbol", "quantity"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/$defs/ticker" },
        "quantity": { "$ref": "#/$defs/quantity" },
        "using": { "$ref": "#/$defs/using" }
      }
    },

    "targetAction": {
      "type": "object",
      "required": ["symbol", "percent", "using"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/$defs/ticker" },
        "percent": { "$ref": "#/$defs/percent" },
        "using": { "$ref": "#/$defs/using" }
      }
    },

    "fxAction": {
      "type": "object",
      "required": ["from", "to", "quantity"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "quantity": { "$ref": "#/$defs/quantity" }
      }
    },

    "action": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["sell"],   "properties": { "sell":   { "$ref": "#/$defs/sellAction" } } },
        { "required": ["buy"],    "properties": { "buy":    { "$ref": "#/$defs/buyAction" } } },
        { "required": ["target"], "properties": { "target": { "$ref": "#/$defs/targetAction" } } },
        { "required": ["fx"], "properties": { "fx": { "$ref": "#/$defs/fxAction" } } }
      ]
    }
  }
}
